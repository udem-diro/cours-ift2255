---
// Layout des pages de références en cartes. Remplace la version à sommaire latéral.
import Layout from "./Layout.astro";

interface Props {
  title: string;
  color: string;
  intro: string;
}
const { title, color, intro } = Astro.props;
---

<Layout title={`${title} — Références IFT2255`} description={`Références IFT2255 : ${title}`}>
  <header class="ref-entete" style={`--theme: ${color}`}>
    <div class="ref-bande">
      <nav class="ref-fil" aria-label="Fil d'Ariane">
        <a href="/">IFT2255</a>
        <span aria-hidden="true">/</span>
        <a href="/references/">Références</a>
      </nav>
      <h1>{title}</h1>
      <p class="ref-intro">{intro}</p>
      <p class="ref-mode">
        Chaque carte s'ouvre sur ses volets, et chaque volet sur ses illustrations.
      </p>
    </div>
  </header>

  <main class="ref-bande ref-principal" style={`--theme: ${color}`}>
    <slot />
  </main>

  <footer class="ref-pied">
    <p class="ref-bande"><a href="/">Retour à la carte du cours</a></p>
  </footer>
</Layout>

<style is:global>
  .ref-bande {
    max-width: 1120px; /* aligné sur la barre de navigation */
    margin: 0 auto;
    padding-left: 1.25rem;
    padding-right: 1.25rem;
  }
  .ref-entete {
    border-bottom: 4px solid var(--theme);
    background: color-mix(in srgb, var(--theme) 8%, var(--papier));
    padding: 3.4rem 0 1.7rem; /* laisse la place au logo qui déborde de la barre */
  }
  .ref-fil {
    font: 500 0.85rem/1 var(--police-titres);
  }
  .ref-fil a {
    text-decoration: none;
    color: #5a6478;
  }
  .ref-fil a:hover {
    color: var(--encre);
    text-decoration: underline;
  }
  .ref-fil span {
    margin: 0 0.4rem;
    color: #9aa3b5;
  }
  .ref-entete h1 {
    margin: 0.6rem 0 0.4rem;
    font-size: clamp(1.9rem, 4vw, 2.7rem);
    letter-spacing: -0.01em;
  }
  .ref-intro {
    margin: 0;
    max-width: 48rem;
    line-height: 1.6;
    color: #3a445c;
  }
  .ref-mode {
    margin: 0.7rem 0 0;
    font-size: 0.85rem;
    color: #5a6478;
  }
  .ref-principal {
    padding-top: 1.8rem;
    padding-bottom: 3rem;
  }
  .ref-pied {
    border-top: 1px solid var(--ligne);
  }
  .ref-pied p {
    padding-top: 1.1rem;
    padding-bottom: 1.1rem;
    font-size: 0.85rem;
  }
</style>