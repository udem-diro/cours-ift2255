        padding: 0.25rem 0.5rem; margin-top: 0.15rem;
      }
      .objectif h3 { font-size: 0.98rem; margin: 0 0 0.25rem; }
      .objectif p { font-size: 0.89rem; color: var(--encre-douce); margin: 0; }

      .sous-titre { font-size: 1.15rem; margin-top: 2rem; }
